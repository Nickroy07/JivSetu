# Copy to backend/.env and fill in. Never commit the real .env.
APP_NAME=Jivsetu AI API
ENVIRONMENT=development            # development | production

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
PATIENT_TOKEN_EXPIRE_MINUTES=240

# MySQL (recommended / required in production):
#   DATABASE_URL=mysql+pymysql://jivsetu_app:<password>@127.0.0.1:3306/jivsetu?charset=utf8mb4
# Local development without MySQL:
#   DATABASE_URL=sqlite:///./jivsetu_dev.db
DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DOCUMENT_STORAGE_PATH=./storage/medical_documents
MAX_UPLOAD_MB=10

# dev = code shown on screen (refused in production); msg91 = real SMS.
OTP_PROVIDER=dev
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# true only for demonstrations; enables `python init_db.py --demo`.
DEMO_MODE=false

# ABDM: disabled | mock | sandbox. `mock` never contacts ABDM (development only).
# `sandbox` needs credentials issued by ABDM after registration; live exchange is not implemented yet.
ABDM_MODE=disabled
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=

# Optional AI-organised draft (OpenRouter). Leave empty to keep AI off.
# Set only in backend/.env or the host secret store; never commit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
